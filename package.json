{
  "name": "glance",
  "productName": "Glance",
  "version": "1.3.1",
  "description": "View, mark up and convert PDFs and images on Windows and macOS.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:legacy": "npx --yes electron@26.6.10 .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:mac-legacy": "electron-builder --mac --config build/mac-legacy.config.js"
  },
  "author": "Muhamad Irfan Harahap",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.glance.viewer",
    "productName": "Glance",
    "files": [
      "src/**/*",
      "node_modules/pdfjs-dist/build/pdf.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.mjs",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/web/pdf_viewer.css",
      "node_modules/pdfjs-dist/web/images/**/*",
      "node_modules/pdf-lib/dist/pdf-lib.esm.js",
      "node_modules/@cantoo/pdf-lib/dist/pdf-lib.esm.js",
      "package.json",
      "!node_modules/@cantoo/pdf-lib/{cjs,es,src,ts3.4,upng,standard-fonts}/**",
      "!node_modules/culori/**",
      "!node_modules/node-html-better-parser/**",
      "!node_modules/fflate/**",
      "!node_modules/tslib/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdf-lib/es/**",
      "!node_modules/pdf-lib/cjs/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "bmp",
          "webp",
          "avif"
        ],
        "name": "Image",
        "role": "Viewer"
      }
    ]
  }
}
